# ============================================================
# Russa Tattoo Studio — Variáveis de Ambiente
# ============================================================
# Copie este ficheiro para .env.local e preencha os valores.
# NUNCA faça commit do .env.local no repositório.
# ============================================================

# ── Neon PostgreSQL ──────────────────────────────────────────
# URL de conexão do Neon PostgreSQL (serverless)
# Obtenha em: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/russa_tattoo?sslmode=require"

# ── Auth.js (NextAuth v5) ────────────────────────────────────
# Chave secreta para encriptação de tokens JWT
# Gere com: npx auth secret
AUTH_SECRET="sua-chave-secreta-aqui"

# URL base da aplicação (usado pelo Auth.js para callbacks)


# E-mail da administradora (único e-mail com acesso ao /admin)
ADMIN_EMAIL="tiagodearaujo13@gmail.com"

NEXT_PUBLIC_APP_URL="https://russa-tattoo.vercel.app"
NEXTAUTH_URL="https://russa-tattoo.vercel.app"

# ── Upstash Redis ────────────────────────────────────────────
# Redis REST API para rate limiting (serverless/edge-compatible)
# Obtenha em: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu-token-aqui"

# ── Resend (E-mails Transacionais) ──────────────────────────
# API Key do Resend para envio de e-mails
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY="re_xxx"

# Remetente dos e-mails (usar domínio verificado em produção)
# Sandbox para testes: onboarding@resend.dev
EMAIL_FROM="onboarding@resend.dev"

# ── UploadThing (Upload de Imagens) ──────────────────────────
# Token de autenticação do UploadThing
# Obtenha em: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="seu-token-aqui"

# ── Informações do Estúdio (Configuráveis) ───────────────────
# Dados de contacto exibidos na landing page
NEXT_PUBLIC_STUDIO_NAME="Russa Tattoo Studio"
NEXT_PUBLIC_STUDIO_PHONE="+351 912 345 678"
NEXT_PUBLIC_STUDIO_ADDRESS="Rua do Estúdio, 42 — Faro, Algarve, Portugal"
NEXT_PUBLIC_STUDIO_INSTAGRAM="https://www.instagram.com/russatatuadora/"
NEXT_PUBLIC_STUDIO_WHATSAPP="351912345678"
NEXT_PUBLIC_STUDIO_MAPS_URL="https://maps.google.com/?q=Algarve+Portugal"
NEXT_PUBLIC_STUDIO_MAP_EMBED=""
